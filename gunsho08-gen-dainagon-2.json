 "poems": [
  {
   "seq": "1",
   "text": "年をへてひかけにみれと小忌衣すりめ〓とにもめつらしきかな",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "きてなるゝとはなけれ共をみ衣ゆきすりにみて年そへにける",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "水鳥は河邊のかせと思ふらんおのかたちゐにさはく波おと",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "川近き宿のすみかは水鳥のたちゐにつけて夢そさめける",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "花もみなかれぬる野へにかはらぬは招くを花の心なりけり",
   "kana": "",
   "speaker": "",
   "page": 474,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春秋の花の折にもまさりけり霜かれわたる野へのけしきは",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "高砂の尾上の松は君かへむためしにとてやおひはしめけむ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "みかりのゝ高く聞ゆる鈴の音に忍ふるきしを思ひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "はし鷹のとふ尾の鈴の音すなりのへの雉子はたつ空もあらし",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "いにしへもかくみえけれは久堅の月をあかしといふにや有覽",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "降雪はきえあへすとも吉野山いつしか春の霞たちなむ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "秋のよの月をみつゝやいにしへの人もあかしの浦といひけむ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "梓弓はるこそひきてまたれつれ花に心のいれはなるへし",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "まつ人のくるとそおもふ夕暮にすたれ吹いるゝ秋風のこゑ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "荻の葉のはをふきみたる秋風はよふかくめをも覺しつる哉",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "逢坂の關はとめねと秋霧にたちこめられてこえそかねつる",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
